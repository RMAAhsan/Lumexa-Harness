# Copy to .env and fill in. Anthropic is required; OpenAI is optional
# (without it, OpenAI-routed phases fall back to the Claude model in config/routing.json).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Stock media for generated apps (optional; without them images are generated with OpenAI or taken from Openverse).
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
