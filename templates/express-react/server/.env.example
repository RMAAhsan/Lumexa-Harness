# Matches docker-compose.yml at the repo root (docker compose up -d).
DATABASE_URL="postgresql://app:app@localhost:5433/app"
# Tests wipe this database on every run. It must differ from DATABASE_URL.
TEST_DATABASE_URL="postgresql://app:app@localhost:5433/app_test"
JWT_SECRET="change-me-to-a-long-random-string"
# Payments (Stripe). Leave empty to run in simulated mode: checkouts succeed instantly, no money moves.
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Public URL of the app, used for payment return links (no trailing slash).
APP_URL="http://localhost:3001"
